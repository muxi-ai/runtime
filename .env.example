# MUXI Runtime - Docker Compose Environment Variables
# Copy this file to .env and fill in your values
# Usage: cp .env.example .env

# ============================================================================
# IMPORTANT: API Keys & Secrets
# ============================================================================
# MUXI uses encrypted secrets (secrets.enc + .key) stored in formation directories.
# DO NOT put API keys in this .env file!
#
# To add secrets to your formation:
#   1. cd formations/your-formation
#   2. python ../../utils/add_secret.py
#   3. Follow the prompts to add keys (e.g., OPENAI_API_KEY)
#
# Your formation YAML references secrets like:
#   api_keys:
#     openai: "${{ secrets.OPENAI_API_KEY }}"
#
# See DOCKER_COMPOSE_GUIDE.md for details.

# ============================================================================
# Docker Configuration
# ============================================================================

# Port for main MUXI service
MUXI_PORT=8000

# Port for production MUXI service
MUXI_PROD_PORT=8001

# Formations directory (where your YAML files are)
FORMATIONS_DIR=./formations

# Data directory (for persistent storage)
DATA_DIR=./data

# Logs directory
LOGS_DIR=./logs

# ============================================================================
# PostgreSQL Configuration (For Production Setup)
# ============================================================================

# PostgreSQL port
POSTGRES_PORT=5432

# Database name
POSTGRES_DB=muxi

# Database user
POSTGRES_USER=muxi

# Database password (CHANGE THIS IN PRODUCTION!)
POSTGRES_PASSWORD=muxi_password

# ============================================================================
# Advanced Options (Optional)
# ============================================================================

# Debug mode (set to 1 for verbose logging)
# DEBUG=0

# Python optimization level
# PYTHONOPTIMIZE=1

# Timezone
# TZ=UTC
