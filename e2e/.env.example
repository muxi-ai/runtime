# E2E Test Environment Variables
# Copy this file to .env.e2e and fill in your actual values

# Database Configuration
POSTGRES_URI=postgresql://muxi:muxi_test_password@localhost:5432/muxi_test
SQLITE_PATH=/tmp/muxi_test.db

# Vector Database (two instances required)
FAISSX_NO_AUTH_URL=http://localhost:45678
FAISSX_WITH_AUTH_URL=http://localhost:65432

# API Keys for LLM Providers (REQUIRED)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...  # Optional but recommended
GEMINI_API_KEY=...  # Optional

# A2A Registry
A2A_REGISTRY_URL=http://localhost:8090

# Webhook Testing
WEBHOOK_URL=http://localhost:8080

# Test Configuration
TEST_PARALLEL_WORKERS=4
TEST_TIMEOUT_MULTIPLIER=1.0
TEST_VERBOSE=true
TEST_CLEANUP=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=jsonl