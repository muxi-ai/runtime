Bootstrap: docker
From: muxi-runtime:latest

# This definition file converts the Docker image to SIF format
# First build the Docker image: ./build-docker.sh basic
# Then build the SIF: apptainer build muxi-runtime.sif muxi-runtime.def

%post
    echo "Converting Docker image to SIF..."
    echo "No additional setup needed - everything is in the Docker image"

%environment
    export PYTHONPATH=/app/src:/app:$PYTHONPATH
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    # Default: Run MUXI formation server
    cd /app
    exec python -m muxi.server "$@"

%startscript
    # For running as instance
    cd /app
    exec python -m muxi.server "$@"

%test
    # Verify Python installation
    echo "Testing Python installation..."
    python --version
    
    # Verify MUXI runtime
    echo "Testing MUXI runtime..."
    python -c "import muxi; print(f'✅ MUXI Runtime {muxi.__version__}')" || exit 1
    
    # Test core dependencies
    echo "Testing dependencies..."
    python -c "import fastapi, onellm; print('✅ Core dependencies loaded')" || exit 1
    
    # Verify system tools
    echo "Testing system tools..."
    which ffmpeg > /dev/null && echo "✅ FFmpeg available" || exit 1
    which tesseract > /dev/null && echo "✅ Tesseract available" || exit 1
    
    echo "All tests passed! ✅"

%labels
    Author Ran Aroussi
    Version 1.0.0
    Description MUXI Runtime - AI Agent Formation Container
    License Elastic-2.0
    URL https://muxi.org

%help
    ===========================================================
    MUXI Runtime Container
    ===========================================================
    
    This container packages the MUXI runtime for executing 
    AI agent formations.
    
    Usage Examples:
    
    1. Run formation server (default)
       $ singularity run muxi-runtime.sif
    
    2. Execute specific Python script
       $ singularity exec muxi-runtime.sif python your_script.py
    
    3. Interactive shell
       $ singularity shell muxi-runtime.sif
    
    4. Run with bind mounts
       $ singularity run \
           --bind ./formations:/formations \
           --bind ./data:/data \
           --bind ./logs:/logs \
           muxi-runtime.sif
    
    Environment Variables:
      MUXI_FORMATIONS_DIR  - Directory for formation files
      MUXI_LOGS_DIR        - Directory for logs
      MUXI_DATA_DIR        - Directory for data storage
      OPENAI_API_KEY       - OpenAI API key (if needed)
      ANTHROPIC_API_KEY    - Anthropic API key (if needed)
    
    For more information:
      https://muxi.org/docs
      https://github.com/muxi-ai/runtime
    
    ===========================================================
